# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=notes_app
DB_DIALECT=mysql

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=7d

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# General Application
APP_NAME=Notes App Backend
APP_VERSION=1.0.0
