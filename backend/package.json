{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "description": "Notes App Backend API - Module 2: Database Schema & Models (MongoDB/Mongoose)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "mocha 'test/**/*.test.js' --timeout 60000 --exit",
    "test:watch": "mocha 'test/**/*.test.js' --watch --timeout 60000",
    "test:coverage": "nyc --reporter=lcov --reporter=text --reporter=html mocha 'test/**/*.test.js' --timeout 60000 --exit",
    "lint": "eslint src/"
  },
  "keywords": [
    "notes",
    "api",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "10 Pearls Internship",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "mongoose": "^7.6.3",
    "mongoose-paginate-v2": "^1.7.4",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "validator": "^13.11.0"
  },
  "nyc": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/config/**",
      "src/templates/**",
      "test/**"
    ],
    "branches": 60,
    "lines": 70,
    "functions": 70,
    "statements": 70,
    "check-coverage": false
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "chai": "^4.3.10",
    "mocha": "^7.2.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.2",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  }
}
